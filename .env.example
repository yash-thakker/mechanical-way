# Copy to .env.local (git-ignored) and fill in what you need. EVERY var here is
# optional — with none of them set the game runs exactly as it should, just
# without a leaderboard. There is no hardcoded domain anywhere in src/.
#
# Only VITE_-prefixed vars reach the browser bundle (Vite's rule). Never put a
# secret in this file: anything here ships to every visitor.

# ---------------------------------------------------------------------------
# The bench records board
# ---------------------------------------------------------------------------
# The deployed Cloudflare Worker (see server/README.md). Unset = no board, no
# requests, no errors — a supported state, not a broken one.
#   local in-memory board:  http://127.0.0.1:8787   (npm run board)
#   deployed:               https://mechanical-way-board.<you>.workers.dev
VITE_LEADERBOARD_API=

# ---------------------------------------------------------------------------
# Canonical address
# ---------------------------------------------------------------------------
# Printed on the share card and used for challenge links. LEAVE IT UNSET unless
# you have a canonical domain: unset means "wherever this page is served from",
# which is right for localhost, forks and preview deploys alike. Set it only to
# force every shared card to advertise one address.
#   e.g. https://mechanicalway.game/
VITE_PAGE_URL=

# What the game calls itself in share text. Defaults to "The Mechanical Way".
VITE_SITE_NAME=
