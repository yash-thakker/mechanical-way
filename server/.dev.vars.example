# Copy to server/.dev.vars (git-ignored). Read by `wrangler dev` only — these
# never reach a deployed worker, which takes its vars from wrangler.toml and its
# secrets from `wrangler secret put`.

# Origins allowed to write to the board while developing. Empty allows any.
ALLOWED_ORIGINS = "http://localhost:5173,http://localhost:5180"

# Any non-empty string locally. In production this is a real secret — it salts
# the IP hashes behind the rate limiter, so a weak one makes those hashes
# guessable.
IP_SALT = "local-dev-salt"
